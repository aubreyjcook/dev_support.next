# ---------------------------------------------------------------------------
# Support Desk configuration
# Copy to `.env.local` and adjust. All values are optional in development.
# ---------------------------------------------------------------------------

# Where the SQLite file lives. Relative paths resolve from the project root.
# DATABASE_PATH=data/helpdesk.db

# Initial password for the seeded demo accounts (development / first run only).
# ALWAYS set this (or disable seeding) before exposing the app to real users.
# SEED_PASSWORD=helpdesk123

# Set to "false" to skip demo users and sample tickets entirely.
# SEED_DEMO=true
